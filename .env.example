# Chatlet configuration
# Copy to .env (or set as environment variables) — all optional.

# Port the server listens on
PORT=5314

# Password for the /admin dashboard. CHANGE THIS before deploying publicly.
ADMIN_PASSWORD=admin

# Where the SQLite database lives (defaults to ./data)
# DATA_DIR=/var/lib/chatlet

# --- Offline message email notifications (BYO SMTP, all optional) ---
# When no agent is online and a visitor leaves a message, Chatlet can email you.
# These can also be configured in the dashboard under Settings.
# SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=app-password
# SMTP_FROM=chatlet@yourdomain.com
# NOTIFY_EMAIL=you@yourdomain.com
